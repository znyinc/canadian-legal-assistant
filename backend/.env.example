# Server configuration
PORT=3001
NODE_ENV=development

# API security (optional)
API_KEY_ENABLED=false
API_KEY=your-secret-api-key-here

# CORS
CORS_ORIGIN=http://localhost:5173

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Database
DATABASE_URL="file:./prisma/dev.db"

# CanLII API
CANLII_API_KEY=

# Local settings screen for provider/key management
ALLOW_RUNTIME_ENV_EDITING=false

# LiteLLM proxy (recommended primary gateway)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_FAST_MODEL=litellm-fast
LITELLM_SMART_MODEL=litellm-smart

# Optional semantic search ranking through the BYOK semantic-router stack in D:\Code\search.
# Use http://localhost:8080/v1 when running that router; model "embedding" is routed to LiteLLM.
# If the router requires auth, set SEMANTIC_SEARCH_API_KEY to its ROUTER_API_KEY value.
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_SEARCH_BASE_URL=http://localhost:8080/v1
SEMANTIC_SEARCH_API_KEY=
SEMANTIC_SEARCH_EMBEDDING_MODEL=embedding
SEMANTIC_SEARCH_MIN_SCORE=0.25

# Direct provider credentials (optional fallback when LiteLLM is unavailable)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-4.1-nano
OPENAI_SMART_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
CLAUDE_FAST_MODEL=claude-haiku-4-5
CLAUDE_SMART_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_SMART_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=llama3:latest
OLLAMA_SMART_MODEL=llama3:latest

# Legacy nuance LLM settings (kept for backward compat; ModelRouter is preferred)
NUANCE_LLM_MODEL=qwen2.5:32b
